generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                 Int            @id @default(autoincrement())
  empId              String         @unique
  barcodeId          String?        @unique
  name               String
  position           String?
  department         String?
  email              String?
  contact            String?
  joiningDate        String?
  salary             String?        @default("Not Disclosed")
  project            String?
  projectStatus      String?
  teamLead           String?
  dailyWorkStatus    String?
  photo              String?
  password           String         @default("hps@1234")
  createdAt          DateTime       @default(now())
  isAttendanceLeader Boolean        @default(false)
  attendance         Attendance[]
  leaveRequest       LeaveRequest[]
  projects           Project[]
  tasks              Task[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  empId     String
  status    String
  timestamp DateTime @default(now())
  employee  Employee @relation(fields: [empId], references: [empId], onDelete: Cascade)
}

model LeaveRequest {
  id             Int       @id @default(autoincrement())
  empId          String
  date           DateTime
  fromDate       DateTime?
  toDate         DateTime?
  isHalfDay      Boolean   @default(false)
  halfDaySession String?
  reason         String
  status         String    @default("Pending")
  type           String    @default("Leave")
  createdAt      DateTime  @default(now())
  employee       Employee  @relation(fields: [empId], references: [empId], onDelete: Cascade)
}

model Announcement {
  id          Int       @id @default(autoincrement())
  title       String
  body        String
  type        String    @default("global")
  targetEmpId String?
  priority    String    @default("normal")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

model OfficeSetting {
  id            Int      @id @default(autoincrement())
  checkInTime   String   @default("09:00")
  checkOutTime  String   @default("18:00")
  lateAfter     String   @default("09:15")
  halfDayBefore String   @default("13:00")
  workingDays   String   @default("Mon,Tue,Wed,Thu,Fri,Sat")
  officeName    String   @default("HPS Pvt Ltd")
  officeAddress String   @default("")
  officePhone   String   @default("")
  officeEmail   String   @default("")
  updatedAt     DateTime @updatedAt
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  empId        String?
  employeeName String?
  action       String
  category     String
  details      String?
  createdAt    DateTime @default(now())

  @@index([empId])
  @@index([category])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  type      String
  target    String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id         Int               @id @default(autoincrement())
  empId      String
  name       String
  status     String            @default("Not Started")
  assignedBy String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  employee   Employee          @relation(fields: [empId], references: [empId], onDelete: Cascade)
  documents  ProjectDocument[]
  tasks      Task[]
}

model Task {
  id          Int            @id @default(autoincrement())
  projectId   Int
  empId       String
  title       String
  description String?
  status      String         @default("Not Started")
  priority    String         @default("medium")
  assignedBy  String
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  employee    Employee       @relation(fields: [empId], references: [empId], onDelete: Cascade)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents   TaskDocument[]
}

model ProjectDocument {
  id           Int      @id @default(autoincrement())
  projectId    Int
  filename     String
  originalName String
  mimetype     String
  size         Int
  uploadedBy   String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TaskDocument {
  id           Int      @id @default(autoincrement())
  taskId       Int
  filename     String
  originalName String
  mimetype     String
  size         Int
  uploadedBy   String
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
