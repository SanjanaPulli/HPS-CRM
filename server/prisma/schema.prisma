generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id                 Int             @id @default(autoincrement())
  empId              String          @unique
  barcodeId          String?         @unique
  name               String
  position           String?
  department         String?
  email              String?
  contact            String?
  joiningDate        String?
  salary             String?         @default("Not Disclosed")
  project            String?
  projectStatus      String?
  teamLead           String?
  dailyWorkStatus    String?
  photo              String?
  password           String          @default("hps@1234")
  createdAt          DateTime        @default(now())
  isAttendanceLeader Boolean         @default(false)
  attendance         Attendance[]
  leaveRequest       LeaveRequest[]
  projects           Project[]
  ledProjects        Project[]       @relation("ProjectTeamLead")
  projectMembers     ProjectMember[]
}

model Attendance {
  id               Int       @id @default(autoincrement())
  empId            String
  status           String    // Present | Late | Absent | On Leave
  timestamp        DateTime  @default(now())  // check-in time
  checkInTime      DateTime?
  checkOutTime     DateTime?
  hoursWorked      Float?    // decimal hours e.g. 8.5
  overtimeMinutes  Int?      // can be negative (left early)

  employee         Employee  @relation(fields: [empId], references: [empId])
}

model LeaveRequest {
  id             Int       @id @default(autoincrement())
  empId          String
  date           DateTime
  fromDate       DateTime?
  toDate         DateTime?
  fromTime       String?
  toTime         String?
  isHalfDay      Boolean   @default(false)
  halfDaySession String?
  reason         String
  status         String    @default("Pending")
  type           String    @default("Leave")
  createdAt      DateTime  @default(now())
  employee       Employee  @relation(fields: [empId], references: [empId], onDelete: Cascade)
}

model Announcement {
  id          Int       @id @default(autoincrement())
  title       String
  body        String
  type        String    @default("global")
  targetEmpId String?
  priority    String    @default("normal")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

model OfficeSetting {
  id            Int      @id @default(autoincrement())
  checkInTime   String   @default("09:00")
  checkOutTime  String   @default("18:00")
  lateAfter     String   @default("09:15")
  halfDayBefore String   @default("13:00")
  workingDays   String   @default("Mon,Tue,Wed,Thu,Fri,Sat")
  officeName    String   @default("HPS Pvt Ltd")
  officeAddress String   @default("")
  officePhone   String   @default("")
  officeEmail   String   @default("")
  updatedAt     DateTime @updatedAt
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  empId        String?
  employeeName String?
  action       String
  category     String
  details      String?
  createdAt    DateTime @default(now())

  @@index([empId])
  @@index([category])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  type      String
  target    String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id          Int               @id @default(autoincrement())
  empId       String
  name        String
  status      String            @default("Planning")
  assignedBy  String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  description String?
  priority    String            @default("medium")
  startDate   DateTime?
  endDate     DateTime?
  progress    Int               @default(0)
  budget      String?
  category    String?
  teamLeadId  String?
  employee    Employee          @relation(fields: [empId], references: [empId], onDelete: Cascade)
  teamLead    Employee?         @relation("ProjectTeamLead", fields: [teamLeadId], references: [empId])
  documents   ProjectDocument[]
  members     ProjectMember[]
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  empId     String
  role      String   @default("member")
  createdAt DateTime @default(now())
  employee  Employee @relation(fields: [empId], references: [empId], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, empId])
}

model ProjectDocument {
  id           Int      @id @default(autoincrement())
  projectId    Int
  filename     String
  originalName String
  mimetype     String
  size         Int
  uploadedBy   String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime
  name      String
  type      String   @default("National") // National | Optional | Company
  createdAt DateTime @default(now())
}