generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id              Int            @id @default(autoincrement())
  empId           String         @unique
  barcodeId       String?        @unique
  name            String
  position        String?
  department      String?
  email           String?
  contact         String?
  joiningDate     String?
  salary          String?        @default("Not Disclosed")
  project         String?
  projectStatus   String?
  teamLead        String?
  dailyWorkStatus String?
  photo           String?
  password        String         @default("hps@1234")
  createdAt       DateTime       @default(now())
  attendance      Attendance[]
  leaveRequest    LeaveRequest[]
  isAttendanceLeader Boolean @default(false)
  projects Project[]
  tasks    Task[]
}

model Attendance {
  id         Int      @id @default(autoincrement())
  empId      String
  status     String
  timestamp  DateTime @default(now())
  employee   Employee @relation(fields: [empId], references: [empId], onDelete: Cascade)
}

model LeaveRequest {
  id        Int      @id @default(autoincrement())
  empId     String
  date      DateTime
  fromDate  DateTime?
  toDate    DateTime?
  isHalfDay Boolean  @default(false)
  halfDaySession String?
  reason    String
  status    String   @default("Pending")
  type      String   @default("Leave")   // "Leave" or "WFH"
  createdAt DateTime @default(now())
  employee  Employee @relation(fields: [empId], references: [empId], onDelete: Cascade)

}

model Announcement {
  id          Int       @id @default(autoincrement())
  title       String
  body        String
  type        String    @default("global")
  targetEmpId String?
  priority    String    @default("normal")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

model OfficeSetting {
  id             Int      @id @default(autoincrement())
  checkInTime    String   @default("09:00")   // "HH:MM" 24hr
  checkOutTime   String   @default("18:00")
  lateAfter      String   @default("09:15")   // marked Late if scan after this
  halfDayBefore  String   @default("13:00")   // if scan before checkOut but after this = half day
  workingDays    String   @default("Mon,Tue,Wed,Thu,Fri,Sat")  // comma-separated
  officeName     String   @default("HPS Pvt Ltd")
  officeAddress  String   @default("")
  officePhone    String   @default("")
  officeEmail    String   @default("")
  updatedAt      DateTime @updatedAt
}

model ActivityLog {
  id            Int      @id @default(autoincrement())

  empId         String?
  employeeName  String?

  action        String
  category      String
  details       String?

  createdAt     DateTime @default(now())

  @@index([empId])
  @@index([category])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  type      String
  target    String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id         Int               @id @default(autoincrement())
  empId      String
  name       String
  status     String            @default("Not Started")
  assignedBy String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  tasks      Task[]
  documents  ProjectDocument[]
  employee   Employee          @relation(fields: [empId], references: [empId], onDelete: Cascade)
}

model Task {
  id          Int            @id @default(autoincrement())
  projectId   Int
  empId       String
  title       String
  description String?
  status      String         @default("Not Started")
  priority    String         @default("medium")
  assignedBy  String
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  documents   TaskDocument[]
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee    Employee       @relation(fields: [empId], references: [empId], onDelete: Cascade)
}


model ProjectDocument {
  id           Int      @id @default(autoincrement())
  projectId    Int
  filename     String
  originalName String
  mimetype     String
  size         Int
  uploadedBy   String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TaskDocument {
  id           Int      @id @default(autoincrement())
  taskId       Int
  filename     String
  originalName String
  mimetype     String
  size         Int
  uploadedBy   String
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}